<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Paperdoll.App.FilesWindow"
        Icon="/Assets/icon.png"
        Title="Files on this computer"
        Width="620" Height="420" CanResize="True" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="80" Click="OnClose" />
      <TextBlock Name="StatusText" Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
               Text="Characters you open or export stay wherever you put them. Paperdoll never sends them anywhere." />
    <ScrollViewer>
      <StackPanel Name="Rows" Spacing="12" />
    </ScrollViewer>
  </DockPanel>
</Window>
