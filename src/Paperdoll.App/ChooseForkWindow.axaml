<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Paperdoll.App.ChooseForkWindow"
        Icon="/Assets/icon.png"
        Title="Which Fork?"
        Width="420" Height="380" CanResize="True" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Name="OkButton" Content="OK" Width="90" Click="OnOk" IsDefault="True" IsEnabled="False" />
      <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True" />
    </StackPanel>
    <ListBox Name="ForkList" SelectionMode="Single" SelectionChanged="OnSelection" DoubleTapped="OnOk" />
  </DockPanel>
</Window>
