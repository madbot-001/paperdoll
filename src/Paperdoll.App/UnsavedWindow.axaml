<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Paperdoll.App.UnsavedWindow"
        Icon="/Assets/icon.png"
        Title="Unsaved Changes"
        Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Name="SaveButton" Content="Save" Width="90" Click="OnSave" IsDefault="True" />
      <Button Content="Don't save" Width="90" Click="OnDiscard" />
      <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True" />
    </StackPanel>
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
  </DockPanel>
</Window>
